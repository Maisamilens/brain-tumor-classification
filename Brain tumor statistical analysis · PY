def compute_statistics(data_dict, confidence=0.95):
    """
    Compute mean, std, CI, and other statistics for each model
    
    Args:
        data_dict: Dictionary with model names as keys and list of fold results as values
        confidence: Confidence level (default 0.95 for 95% CI)
    
    Returns:
        DataFrame with statistical metrics
    """
    results = []
    
    for model_name, fold_results in data_dict.items():
        fold_array = np.array(fold_results)
        
        # Mean and Standard Deviation
        mean = np.mean(fold_array)
        std = np.std(fold_array, ddof=1)  # Sample std (n-1)
        
        # Standard Error
        sem = stats.sem(fold_array)
        
        # Confidence Interval (using t-distribution for small samples)
        n = len(fold_array)
        df = n - 1
        t_value = stats.t.ppf((1 + confidence) / 2, df)
        ci_lower = mean - t_value * sem
        ci_upper = mean + t_value * sem
        ci_width = ci_upper - ci_lower
        
        # Min and Max
        min_val = np.min(fold_array)
        max_val = np.max(fold_array)
        
        results.append({
            'Model': model_name,
            'Mean': mean,
            'Std Dev': std,
            'SEM': sem,
            'CI Lower (95%)': ci_lower,
            'CI Upper (95%)': ci_upper,
            'CI Width': ci_width,
            'Min': min_val,
            'Max': max_val,
            'Range': max_val - min_val
        })
    
    return pd.DataFrame(results)

