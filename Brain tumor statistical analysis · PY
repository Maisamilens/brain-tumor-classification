def perform_anova_and_pairwise_tests(data_dict):
    """
    Perform one-way ANOVA and pairwise t-tests with Bonferroni correction
    """
    # Extract model arrays for ANOVA
    model_arrays = [np.array(v) for v in data_dict.values()]
    model_names = list(data_dict.keys())
    
    # One-way ANOVA
    f_statistic, p_value_anova = stats.f_oneway(*model_arrays)
    
    # Pairwise comparisons (Custom CNN vs. others)
    custom_cnn_data = np.array(data_dict['Custom CNN'])
    pairwise_results = []
    
    num_comparisons = len(model_names) - 1
    bonferroni_alpha = 0.05 / num_comparisons  # Bonferroni correction
    
    for model_name in model_names:
        if model_name != 'Custom CNN':
            other_model_data = np.array(data_dict[model_name])
            
            # Independent samples t-test
            t_stat, p_value = stats.ttest_ind(custom_cnn_data, other_model_data)
            
            # Cohen's d (effect size)
            pooled_std = np.sqrt(((len(custom_cnn_data)-1)*np.var(custom_cnn_data, ddof=1) + 
                                  (len(other_model_data)-1)*np.var(other_model_data, ddof=1)) / 
                                 (len(custom_cnn_data) + len(other_model_data) - 2))
            cohens_d = (np.mean(custom_cnn_data) - np.mean(other_model_data)) / pooled_std
            
            # Interpret effect size
            if abs(cohens_d) < 0.2:
                effect_interpretation = "Negligible"
            elif abs(cohens_d) < 0.5:
                effect_interpretation = "Small"
            elif abs(cohens_d) < 0.8:
                effect_interpretation = "Medium"
            else:
                effect_interpretation = "Large"
            
            pairwise_results.append({
                'Custom CNN vs.': model_name,
                'Mean Diff': np.mean(custom_cnn_data) - np.mean(other_model_data),
                't-statistic': t_stat,
                'p-value': p_value,
                'Sig. (Bonferroni)': 'Yes' if p_value < bonferroni_alpha else 'No',
                "Cohen's d": cohens_d,
                'Effect Size': effect_interpretation
            })
    
    return {
        'ANOVA': {'F-statistic': f_statistic, 'p-value': p_value_anova},
        'Pairwise': pd.DataFrame(pairwise_results)
    }

