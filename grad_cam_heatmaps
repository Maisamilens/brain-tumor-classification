def create_visualization(indices, title_prefix, is_error=False):
    """Create a visualization for a set of image indices."""
    if len(indices) == 0:
        return None
    
    num_images = len(indices)
    fig_height = num_images * 2.5 + 1
    
    try:
        fig = plt.figure(figsize=(18, fig_height), dpi=150)
        fig.suptitle(
            f'{title_prefix} - {best_model_name} | {len(indices)} Images',
            fontsize=18, weight='bold', y=0.995
        )
        
        for plot_idx, global_idx in enumerate(indices):
            img_orig = images[global_idx]
            img_resized = cv2.resize(img_orig, IMG_SIZE)
            true_class = CLASS_LABELS[true_labels[global_idx]]
            pred_class = CLASS_LABELS[pred_labels[global_idx]]
            confidence = pred_confidences[global_idx] * 100
            is_correct = true_labels[global_idx] == pred_labels[global_idx]
            
            # Row 1: Original Image with Ground Truth
            ax1 = plt.subplot(num_images, 3, plot_idx * 3 + 1)
            ax1.imshow(img_orig)
            ax1.set_title(f'Original MRI\n[Ground Truth: {true_class.upper()}]', 
                         fontsize=11, weight='bold', color='navy')
            ax1.axis('off')
            
            # Row 2: Prediction Result
            ax2 = plt.subplot(num_images, 3, plot_idx * 3 + 2)
            ax2.imshow(img_resized)
            
            color = 'green' if is_correct else 'red'
            symbol = '✓' if is_correct else '✗'
            title_text = f'Prediction: {pred_class.upper()}\n{symbol} {confidence:.1f}% Confidence'
            ax2.set_title(title_text, fontsize=11, weight='bold', color=color)
            ax2.axis('off')
            
            # Row 3: Grad-CAM Heatmap (skip for notumor)
            ax3 = plt.subplot(num_images, 3, plot_idx * 3 + 3)
            
            if true_class.lower() == 'notumor':
                ax3.imshow(img_resized)
                ax3.set_title('No Tumor Region\n[Heatmap N/A]', fontsize=11, weight='bold', color='gray')
                ax3.axis('off')
            else:
                heatmap = heatmap_data[global_idx]
                if heatmap is not None:
                    superimposed = superimpose_heatmap(img_resized, heatmap, alpha=0.5)
                    ax3.imshow(superimposed)
                    ax3.set_title('Grad-CAM Heatmap\n[Attention Region]', fontsize=11, weight='bold', color='darkblue')
                else:
                    ax3.imshow(img_resized)
                    ax3.set_title('Heatmap Failed', fontsize=11, weight='bold', color='orange')
                ax3.axis('off')
        
        plt.tight_layout()
        return fig
    
    except Exception as e:
        print(f"Error creating visualization: {e}")
        return None

