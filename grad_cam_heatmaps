def load_test_dataset(root_path, class_labels):
    """
    Load all test images with their labels.
    FIXED: Handles images of different sizes without numpy array shape mismatch
    """
    images = []  # Keep as list to handle variable sizes
    labels = []
    paths = []
    
    for class_idx, class_name in enumerate(class_labels):
        class_dir = os.path.join(root_path, class_name)
        if not os.path.exists(class_dir):
            print(f"Warning: Class directory not found: {class_dir}")
            continue
        
        try:
            image_files = [f for f in os.listdir(class_dir) 
                          if f.lower().endswith(('.jpg', '.png', '.jpeg'))]
        except Exception as e:
            print(f"Error reading directory {class_dir}: {e}")
            continue
        
        loaded_count = 0
        for img_file in sorted(image_files):
            img_path = os.path.join(class_dir, img_file)
            try:
                img = cv2.imread(img_path)
                if img is not None:
                    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
                    # Store as list (not numpy array) to handle different sizes
                    images.append(img)
                    labels.append(class_idx)
                    paths.append(img_path)
                    loaded_count += 1
            except Exception as e:
                print(f"Error loading {img_path}: {e}")
                continue
        
        print(f"  {class_name}: {loaded_count} images loaded")
    
    return images, np.array(labels), paths  # Return list for images, array for labels

